# Скопируйте в .env (docker compose) или в /etc/siege.env (systemd).
# Все переменные необязательны: без них работают значения по умолчанию.

# Адрес прослушивания. За nginx держим локальный порт.
SIEGE_ADDR=:8080

# Внешний адрес — только для подсказки в логах при старте.
SIEGE_PUBLIC_URL=https://siege.example.com

# text — читать глазами, json — собирать в systemd/journald или в Loki.
SIEGE_LOG_FORMAT=json
SIEGE_LOG_LEVEL=info

# Защита от запросов с чужих сайтов: точный origin, без слэша на конце.
# По умолчанию выключено — иначе свежая установка молча отбивала бы все
# действия игроков, пока сюда не впишут настоящий адрес. Включайте, когда
# домен известен, и следите, чтобы схема совпадала (http:// или https://).
# SIEGE_ALLOWED_ORIGIN=https://siege.example.com

# Предел одновременных комнат в памяти процесса.
SIEGE_MAX_ROOMS=200

# Через сколько простоя комната удаляется.
SIEGE_ROOM_TTL=2h

# Ограничение времени на ход. 0 — без таймера, минимум 10s.
SIEGE_TURN_TIMEOUT=0

# Пауза между действиями бота, пока его ход видно людям у экранов: без неё
# бот отыгрывает ход быстрее, чем его можно разглядеть. 0 — без пауз.
SIEGE_BOT_DELAY=350ms

# Сколько ждать завершения запросов при остановке.
SIEGE_SHUTDOWN_WAIT=10s

# Серверы ICE для голосовых звонков: JSON-массив в формате RTCConfiguration.
# По умолчанию — публичный STUN Google. STUN хватает, пока оба собеседника не
# за симметричным NAT; для надёжности добавьте свой TURN (см. docs/DEPLOY.md).
# SIEGE_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"siege","credential":"СЕКРЕТ"}]

# Отдавать фронтенд с диска вместо вшитого — только для разработки.
# SIEGE_WEB_DIR=web
